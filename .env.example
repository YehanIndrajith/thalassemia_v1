APP_NAME=THALAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://thalassemia.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/database.sqlite

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Python executable — use 'py' on Windows, 'python3' on Linux/Mac
# Or point to venv: venv/Scripts/python.exe (Windows) / venv/bin/python (Linux/Mac)
PYTHON_EXECUTABLE=py
